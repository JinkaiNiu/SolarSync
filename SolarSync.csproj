<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SolarSync</AssemblyName>
    <RootNamespace>SolarSync</RootNamespace>

    <!-- 开发者信息 -->
    <Authors>JinkaiNiu</Authors>
    <Company>JinkaiNiu</Company>
    <Copyright>Copyright © JinkaiNiu 2026</Copyright>
    <Product>朝夕·光色</Product>
    <Title>朝夕·光色</Title>
    <AssemblyTitle>朝夕·光色</AssemblyTitle>
    <Version>1.0.3.0</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <Description>根据日出日落时间自动切换 Windows 浅色/深色模式。基于 NOAA 太阳位置算法，使用 myip.ipip.net 国内 IP 定位，无需第三方依赖。</Description>

    <!-- 程序图标 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- 打包配置：单文件自包含 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <TrimMode>link</TrimMode>
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\city_coords.json" />
  </ItemGroup>

</Project>
